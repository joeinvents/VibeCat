{
  "name": "vibecat",
  "version": "1.0.0",
  "description": "A tray cat that pops up every minute holding a sign with a positive affirmation.",
  "main": "src/main.js",
  "bin": {
    "vibecat": "bin/vibecat.js"
  },
  "files": [
    "bin/",
    "src/",
    "assets/"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags"
  },
  "keywords": [
    "tray",
    "affirmations",
    "cat",
    "overlay",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeinvents/VibeCat.git"
  },
  "bugs": {
    "url": "https://github.com/joeinvents/VibeCat/issues"
  },
  "homepage": "https://github.com/joeinvents/VibeCat#readme",
  "author": "joeinvents",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "electron": "^39.8.10"
  },
  "allowScripts": {
    "electron@39.8.10": true
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.joeinvents.vibecat",
    "productName": "VibeCat",
    "icon": "assets/icon.png",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "bin/",
      "src/",
      "assets/",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
